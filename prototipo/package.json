{
  "name": "punto-ciego-prototipo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Punto Ciego · demo de la Entrega 4 (TFG, Universidad Siglo 21)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verificar-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint . && tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cartografia": "node scripts/extraer-cartografia.mjs",
    "auditoria": "npm audit --omit=dev --audit-level=moderate",
    "auditoria:dev": "npm audit --audit-level=high",
    "demo:grabar": "playwright test -c demo/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "5.6",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
